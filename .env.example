# Trendly Support Agent — Environment Variables
# Copy this to .env and fill in at least ONE API key

# Option A: Groq (recommended — fast, free) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option B: Google Gemini (free) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Which provider to use: "groq" or "gemini" (auto-detects if not set)
LLM_PROVIDER=groq
